#let nure-state = state("nure-config", (:))

/// Ініціалізує глобальний стан конфігурації документа.
///
/// Використовуйте цю функцію для встановлення спільних метаданих для всіх наступних структурних блоків.
///
/// - subject (string): Коротка назва дисципліни (наприклад, "MGoL").
/// - title (string): Назва роботи або тема.
/// - authors (array): Список словників авторів (`name`, `edu-program`, `group`, `gender`, `variant`).
/// - mentors (array): Список словників керівників (`name`, `degree`, `gender`).
/// - committee-members (array): Необов'язковий список членів комісії для курсових робіт.
/// - faculty (string): Назва факультету.
/// - education-level (string): Рівень вищої освіти (наприклад, "перший (бакалаврський)").
/// - program-type (string): Тип освітньої програми (наприклад, "освітньо-професійна").
/// - program-name (string): Повна назва освітньої програми.
/// - layout (string): Варіант макета сторінки.
/// - edu-program (string): Код освітньої програми (наприклад, "ПЗПІ") або повна назва.
/// - work-type (string): Тип роботи ("ПЗ", "ЛБ", "КР", "РФ", "ІДЗ" або будь-який текст без скорочення).
/// - work-number (integer): Номер практичної або лабораторної роботи.
/// - year (string): Рік виконання роботи.
#let setup(
  subject: none,
  title: none,
  authors: (),
  mentors: (),
  committee-members: none,
  faculty: "комп'ютерних наук",
  education-level: "перший (бакалаврський)",
  program-type: "освітньо-професійна",
  program-name: none,
  layout: "default",
  edu-program: none,
  work-type: none,
  work-number: none,
  year: datetime.today().display("[year]"),
) = {
  let authors-verb = "Виконали"
  if authors.len() == 1 {
    let g = authors.first().at("gender", default: "p")
    if g == "m" { authors-verb = "Виконав" }
    if g == "f" { authors-verb = "Виконала" }
  }

  let mentors-verb = "Перевірили"
  if mentors.len() == 1 {
    let g = mentors.first().at("gender", default: "p")
    if g == "m" { mentors-verb = "Перевірив" }
    if g == "f" { mentors-verb = "Перевірила" }
  }

  let mapped-mentors = mentors.map(m => {
    let d = m.at("degree", default: none)
    (..m, degree-formatted: if d != none and d != "" { [#d\ ] })
  })

  let doc-type-title = none
  if work-type != none {
    let t = (
      "ЛБ": [Звіт \ з лабораторної роботи],
      "ПЗ": [Звіт \ з практичної роботи],
      "КР": [Контрольна робота],
      "РФ": [Реферат],
      "ІДЗ": [Індивідуальне домашнє завдання],
    ).at(work-type, default: work-type)

    doc-type-title = if work-number != none and work-number != "" [#t №#work-number] else [ #t ]
  }

  nure-state.update((
    subject: subject,
    title: title,
    authors: authors,
    mentors: mapped-mentors,
    committee-members: committee-members,
    faculty: faculty,
    education-level: education-level,
    program-type: program-type,
    program-name: program-name,
    layout: layout,
    edu-program: edu-program,
    work-type: work-type,
    work-number: work-number,
    year: year,

    // Computed fields
    authors-verb: authors-verb,
    mentors-verb: mentors-verb,
    doc-type-title: doc-type-title,
  ))
}
